@using BakeryShop.Data
@using BakeryShop.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var categories = await DbContext.Categories.AsNoTracking().ToListAsync();

    var cartCount = 0;
    if (SignInManager.IsSignedIn(User))
    {
        var userId = UserManager.GetUserId(User);
        cartCount = await DbContext.CartItems
            .Where(c => c.UserId == userId)
            .SumAsync(c => c.Quantity);
    }
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BakeryShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Montserrat:wght@400;500;600&family=Pacifico&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BakeryShop.styles.css" asp-append-version="true" />
    <link rel="icon" href="~/Images/favicon.ico" type="image/x-icon" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <div class="topbar py-2">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-telephone-fill"></i> 1900 000 000
                    <span class="ms-3 d-none d-md-inline"><i class="bi bi-envelope-fill"></i> lienhe@bakeryshop.com</span>
                </span>
                <span>
                    <a asp-controller="Home" asp-action="SetLanguage" asp-route-culture="vi-VN"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       class="text-white text-decoration-none me-1">VI</a>|
                    <a asp-controller="Home" asp-action="SetLanguage" asp-route-culture="en-US"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       class="text-white text-decoration-none ms-1 me-3">EN</a>
                    <a asp-controller="Cart" asp-action="Index" class="text-white text-decoration-none">
                        <i class="bi bi-cart3"></i> @L["Giỏ hàng"] (<span id="cart-count">@cartCount</span>)
                    </a>
                </span>
            </div>
        </div>

        <nav class="navbar navbar-expand-sm navbar-dark site-nav mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fs-3" asp-controller="Home" asp-action="Index">BakeryShop</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">@L["Trang chủ"]</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">@L["Sản phẩm"]</a>
                            <ul class="dropdown-menu">
                                @foreach (var category in categories)
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="Category" asp-route-id="@category.Id">@category.Name</a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item fw-bold" asp-controller="Home" asp-action="Menu">@L["Xem tất cả"]</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Menu">Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index" asp-fragment="about">@L["Về chúng tôi"]</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3 @(ViewContext.RouteData.Values["area"]?.ToString() == "Identity" ? "identity-area" : "")">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5>BakeryShop</h5>
                    <ul class="list-unstyled footer-info">
                        <li><i class="bi bi-geo-alt-fill"></i> @L["Cơ sở 1"]: 123 Đường ABC, Hoàn Kiếm, Hà Nội</li>
                        <li><i class="bi bi-geo-alt-fill"></i> @L["Cơ sở 2"]: 45 Đường XYZ, Cầu Giấy, Hà Nội</li>
                        <li><i class="bi bi-telephone-fill"></i> @L["Đặt trước"]: <a href="tel:1900000000">1900 000 000</a></li>
                        <li><i class="bi bi-envelope-fill"></i> <a href="mailto:lienhe@bakeryshop.com">lienhe@bakeryshop.com</a></li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <h5>@L["Mạng xã hội"]</h5>
                    <div class="footer-social">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <div class="col-md-5">
                    <h5>@L["Bản đồ"]</h5>
                    <div class="footer-map">
                        <iframe src="https://maps.google.com/maps?q=Hoan%20Kiem%2C%20Ha%20Noi&output=embed"
                                loading="lazy" allowfullscreen></iframe>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            &copy; 2026 BakeryShop - @L["Bánh ngọt kiểu Pháp, hương vị Việt Nam"]
            <a asp-controller="Home" asp-action="Privacy" class="ms-3">@L["Chính sách"]</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
