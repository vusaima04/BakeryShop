@using Microsoft.AspNetCore.Identity
@using BakeryShop.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">@L["Xin chào"] @User.Identity?.Name!</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Order" asp-action="History">@L["Đơn hàng của tôi"]</a>
        </li>
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
    <a class="nav-link text-dark fw-bold" asp-controller="Dashboard" asp-action="Index">Thống kê</a>
</li>
            <li class="nav-item">
                <a class="nav-link text-dark fw-bold" asp-controller="Products" asp-action="Index">@L["Quản lý"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark fw-bold" asp-controller="AdminOrders" asp-action="Index">@L["Quản lý đơn"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark fw-bold" asp-controller="Categories" asp-action="Index">@L["Danh mục"]</a>
            </li>
        }
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link btn btn-link text-dark">@L["Đăng xuất"]</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">@L["Đăng ký"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">@L["Đăng nhập"]</a>
        </li>
    }
</ul>