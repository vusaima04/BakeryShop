@model BakeryShop.Models.Product

<div class="card h-100 shadow-sm">
    <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="height: 220px; object-fit: cover;">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text text-muted">@Model.Description</p>
        <p class="card-text"><small class="text-muted">Size: @Model.Size</small></p>
        <p class="fw-bold text-danger mt-auto">@Model.Price.ToString("N0") đ</p>
        <form asp-controller="Cart" asp-action="Add" method="post">
            <input type="hidden" name="productId" value="@Model.Id" />
            <button type="submit" class="btn btn-primary w-100">Thêm vào giỏ</button>
        </form>
    </div>
</div>