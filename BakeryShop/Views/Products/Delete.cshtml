@model BakeryShop.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h1>Xóa sản phẩm</h1>

<div class="alert alert-warning">Bạn có chắc muốn xóa sản phẩm này? Hành động này không thể hoàn tác.</div>

<div class="row">
    <div class="col-md-4 mb-3">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded" style="max-height:240px;object-fit:cover;" />
        }
    </div>
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Price)</dt>
            <dd class="col-sm-9">@Model.Price.ToString("N0") đ</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Size)</dt>
            <dd class="col-sm-9">@Model.Size</dd>

            <dt class="col-sm-3">Danh mục</dt>
            <dd class="col-sm-9">@Model.Category?.Name</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <button type="submit" class="btn btn-danger">Xóa</button>
            <a href="@((string?)ViewBag.ReturnUrl ?? Url.Action("Index"))" class="btn btn-outline-secondary">Quay lại</a>
        </form>
    </div>
</div>