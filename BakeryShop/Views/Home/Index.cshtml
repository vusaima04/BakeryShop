@model List<BakeryShop.Models.Product>
@{
    var categories = (ViewBag.Categories as List<BakeryShop.Models.Category>) ?? new List<BakeryShop.Models.Category>();
}
@functions {
    static string CategoryImage(string name) => name switch
    {
        "Bánh Sinh Nhật" => "/Images/categories/banh-sn.png",
        "Bánh Nhỏ"       => "/Images/categories/banh-mini.png",
        "Bánh Nướng"     => "/Images/categories/banh-nuong.png",
        _                => "https://placehold.co/600x400/bc9669/ffffff?text=" + Uri.EscapeDataString(name)
    };
}

<!-- PHẦN 1: SLIDER -->
<div id="heroCarousel" class="carousel slide mb-5" data-bs-ride="carousel" style="border-radius: 12px; overflow: hidden;">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="d-flex align-items-center justify-content-center text-white text-center"
                 style="height: 420px; background: linear-gradient(rgba(0,0,0,.4), rgba(0,0,0,.4)), url('/Images/Slide.png') center / cover no-repeat;">
                <div>
                    <h1 class="display-3 text-white">BÁNH NHỎ GỌN</h1>
                    <p class="fs-4">Trọn yêu thương</p>
                    <a asp-action="Menu" class="btn btn-primary btn-lg mt-3">Đặt hàng ngay</a>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <div class="d-flex align-items-center justify-content-center text-white text-center"
                 style="height: 420px; background: linear-gradient(rgba(0,0,0,.4), rgba(0,0,0,.4)), url('/Images/products/BanhChanh.png') center / cover no-repeat;">
                <div>
                    <h1 class="display-3 text-white">ƯU ĐÃI MỚI</h1>
                    <p class="fs-4">Miễn phí vận chuyển trong bán kính 10km</p>
                    <a asp-action="Menu" class="btn btn-light btn-lg mt-3">Xem menu</a>
                </div>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<!-- PHẦN 2: 3 DANH MỤC NỔI BẬT -->
<div class="row g-4 mb-5">
    @foreach (var category in categories.Take(3))
    {
        <div class="col-md-4">
            <a asp-action="Category" asp-route-id="@category.Id" class="category-tile">
                <img src="@CategoryImage(category.Name)"
     onerror="this.onerror=null;this.src='https://placehold.co/600x400/bc9669/ffffff?text=@(Uri.EscapeDataString(category.Name))'"
     alt="@category.Name" />
                <div class="category-tile-label">@category.Name</div>
            </a>
        </div>
    }
</div>

<!-- PHẦN 3: LƯỚI SẢN PHẨM NỔI BẬT -->
<h2 class="text-center mb-4">Menu</h2>
<div class="row g-4">
    @foreach (var product in Model)
    {
        <div class="col-md-3">
            <partial name="_ProductCard" model="product" />
        </div>
    }
</div>
<div class="text-center my-5">
    <a asp-action="Menu" class="btn btn-primary btn-lg">Xem tất cả</a>
    </div>
@{ var combos = ViewBag.Combos as List<BakeryShop.Models.Product> ?? new(); }
@if (combos.Any())
{
    <h2 class="text-center mb-4">Combo &amp; Ưu đãi</h2>
    <div class="row g-4 mb-5">
        @foreach (var combo in combos)
        {
            <div class="col-md-6 col-lg-4">
                <div class="combo-card">
                    <a asp-action="Detail" asp-route-id="@combo.Id" class="combo-img-wrap">
                        <img src="@combo.ImageUrl" alt="@combo.Name" />
                        <span class="combo-badge">Combo</span>
                    </a>
                    <div class="combo-body">
                        <h5><a asp-action="Detail" asp-route-id="@combo.Id">@combo.Name</a></h5>
                        <p class="text-muted small mb-2">@combo.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="combo-price">@combo.Price.ToString("N0") đ</span>
                            <form asp-controller="Cart" asp-action="Add" method="post" class="js-add-cart">
                                <input type="hidden" name="productId" value="@combo.Id" />
                                <button type="submit" class="btn btn-primary btn-sm">@L["Thêm vào giỏ"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
<!-- PHẦN 5: GIỚI THIỆU NHÀ HÀNG -->
<section id="about" class="row g-4 align-items-stretch my-5">
    <div class="col-md-6">
        <img src="/Images/About.png" class="about-img" alt="Về BakeryShop" />
    </div>
    <div class="col-md-6 d-flex flex-column justify-content-center">
        <h2 class="mb-3">Về chúng tôi</h2>
        <h5 class="text-uppercase mb-3" style="color: var(--color-primary); letter-spacing: 0.08em;">
            Bánh sẻ chia, trọn cuộc sống
        </h5>
        <p>
            BakeryShop là tiệm bánh ngọt theo phong cách Pháp, nơi kỹ thuật làm bánh tinh tế
            gặp gỡ hương vị trái cây nhiệt đới Việt Nam. Mỗi chiếc bánh được làm thủ công,
            từ lớp mousse mịn đến phần nhân tươi mát.
        </p>
        <p>
            Chúng tôi tin rằng một miếng bánh là một lời chia sẻ. Dù là sinh nhật, buổi trà chiều
            hay một ngày bình thường, bánh của BakeryShop luôn mang đến những khoảnh khắc đáng nhớ.
        </p>
        <div>
            <a asp-action="Menu" class="btn btn-primary">Khám phá menu</a>
        </div>
    </div>
</section>

