@model BakeryShop.Models.Order

<div class="container my-5">
    <a asp-action="Index">&larr; Quay lại danh sách</a>
    <h2 class="my-3">Đơn hàng #@Model.Id</h2>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4 bg-white" style="border-radius: 12px;">
                <h4 class="mb-3">Thông tin đơn hàng</h4>
                <p><strong>Khách hàng:</strong> @(ViewBag.Email ?? "(tài khoản đã xóa)")</p>
                <p><strong>Số điện thoại:</strong> @Model.ReceiverPhone</p>
                <p><strong>Địa chỉ giao:</strong> @Model.DeliveryAddress</p>
                <p><strong>Ngày đặt:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Ngày nhận:</strong> @Model.ReceiveDate.ToString("dd/MM/yyyy")</p>
                <p><strong>Ghi chú:</strong> @(string.IsNullOrWhiteSpace(Model.Note) ? "Không có" : Model.Note)</p>
                <p class="mb-0">
                    <strong>Trạng thái:</strong>
                    <span class="badge @OrderStatus.BadgeClass(Model.Status)">@OrderStatus.Label(Model.Status)</span>
                </p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4" style="border-radius: 12px; background-color: #f5ebe0; border-left: 5px solid var(--color-primary) !important;">
                <h4 class="mb-3">Sản phẩm</h4>
                <ul class="list-group list-group-flush">
                    @foreach (var detail in Model.OrderDetails)
                    {
                        <li class="list-group-item d-flex justify-content-between bg-transparent">
                            <span>@detail.Product?.Name x @detail.Quantity</span>
                            <span class="fw-semibold">@((detail.UnitPrice * detail.Quantity).ToString("N0")) đ</span>
                        </li>
                    }
                </ul>
                <h5 class="mt-3 text-end">Tổng cộng: <span class="text-danger">@Model.TotalAmount.ToString("N0") đ</span></h5>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 p-4 bg-white mt-4" style="border-radius: 12px;">
        <h4 class="mb-3">Cập nhật trạng thái</h4>
        <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <select name="status" class="form-select w-auto">
                @foreach (var s in OrderStatus.All)
                {
                    <option value="@s" selected="@(Model.Status == s)">@OrderStatus.Label(s)</option>
                }
            </select>
            <button type="submit" class="btn btn-primary px-4">Cập nhật</button>
        </form>
    </div>
</div>