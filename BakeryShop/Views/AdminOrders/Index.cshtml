@model List<BakeryShop.Models.Order>
@{
    var emails = (Dictionary<string, string>)ViewBag.Emails;
    var current = ViewBag.CurrentStatus as string;
}

<div class="container my-5">
    <h2 class="mb-4">Quản lý đơn hàng</h2>

    <div class="mb-4">
        <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(current) ? "btn-primary" : "btn-outline-secondary")">Tất cả</a>
        @foreach (var s in OrderStatus.All)
        {
            <a asp-action="Index" asp-route-status="@s" class="btn btn-sm @(current == s ? "btn-primary" : "btn-outline-secondary")">@OrderStatus.Label(s)</a>
        }
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">Không có đơn hàng nào.</p>
    }
    else
    {
        <div class="card shadow-sm border-0 p-4 bg-white" style="border-radius: 12px;">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-muted" style="border-bottom: 2px solid var(--color-primary);">
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Khách hàng</th>
                        <th>Ngày nhận</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-semibold">#@order.Id</td>
                            <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(emails.TryGetValue(order.UserId, out var email) ? email : "(tài khoản đã xóa)")</td>
                            <td>@order.ReceiveDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-danger fw-bold">@order.TotalAmount.ToString("N0") đ</td>
                            <td><span class="badge @OrderStatus.BadgeClass(order.Status)">@OrderStatus.Label(order.Status)</span></td>
                            <td><a asp-action="Details" asp-route-id="@order.Id">Chi tiết</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>