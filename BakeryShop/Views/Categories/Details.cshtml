@model BakeryShop.Models.Category

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<h1>Chi tiết danh mục</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">Tên danh mục</dt>
    <dd class="col-sm-10">@Model.Name</dd>
</dl>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Sửa</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</div>