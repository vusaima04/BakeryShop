@model BakeryShop.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<h1>Xóa danh mục</h1>
<div class="alert alert-warning">Bạn có chắc muốn xóa danh mục này?</div>

<dl class="row">
    <dt class="col-sm-2">Tên danh mục</dt>
    <dd class="col-sm-10">@Model.Name</dd>
</dl>

<form asp-action="Delete" class="d-flex gap-2 mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</form>