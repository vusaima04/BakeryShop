@model List<BakeryShop.Models.CartItem>
@{
    var input = ViewBag.Input as CheckoutViewModel;
}
<div class="container my-5">
    <h2 class="mb-4">Xác nhận đơn hàng</h2>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4 bg-white" style="border-radius: 12px;">
                <h4 class="mb-3">Thông tin giao hàng</h4>
                <form asp-action="PlaceOrder" asp-controller="Order" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ nhận hàng</label>
                        <input type="text" name="deliveryAddress" value="@input?.DeliveryAddress" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input type="tel" name="receiverPhone" value="@input?.ReceiverPhone" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ngày nhận hàng</label>
                        <input type="date" name="receiveDate"
                               value="@(input?.ReceiveDate?.ToString("yyyy-MM-dd"))"
                               min="@(DateTime.Today.ToString("yyyy-MM-dd"))"
                               class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ghi chú (không bắt buộc)</label>
                        <textarea name="note" class="form-control">@input?.Note</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Xác nhận đặt hàng</button>
                </form>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4" style="border-radius: 12px; background-color: #f5ebe0; border-left: 5px solid var(--color-primary) !important;">
                <h4 class="mb-3">Đơn hàng của bạn</h4>
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between bg-transparent">
                            <span>@item.Product?.Name x @item.Quantity</span>
                            <span class="fw-semibold">@((item.Product?.Price * item.Quantity)?.ToString("N0")) đ</span>
                        </li>
                    }
                </ul>
                <h5 class="mt-3 text-end">Tổng cộng: <span class="text-danger">@Model.Sum(i => i.Product?.Price * i.Quantity).Value.ToString("N0") đ</span></h5>
            </div>
        </div>
    </div>
</div>